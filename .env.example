# Copy to .env and replace every change-me value:  cp .env.example .env
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
# Use URL-safe values (hex is ideal): passwords are embedded in connection URLs.

# --- PostgreSQL -------------------------------------------------------------------
# Schema owner: used only by migrations.
POSTGRES_DB=georgos
POSTGRES_USER=georgos_owner
POSTGRES_PASSWORD=change-me-owner-password

# Runtime role used by the API (DML only, subject to row-level security).
APP_DB_USER=georgos_app
APP_DB_PASSWORD=change-me-app-password

# --- API --------------------------------------------------------------------------
# At least 32 characters. Signs CSRF tokens and pseudonymizes rate-limit keys.
SECRET_KEY=change-me-generate-a-64-char-hex-secret-here-please-000000

# Comma-separated origins allowed to call the API cross-origin with credentials.
# Leave empty when the frontend is served from the same host (the default setup).
ALLOWED_ORIGINS=

# Keep true. Browsers accept Secure cookies on http://localhost, so this works locally;
# the dev override (docker-compose.override.yml) relaxes it for LAN/mobile testing.
SESSION_COOKIE_SECURE=true

LOG_LEVEL=INFO

# --- Host ports (bound to 127.0.0.1 only) -----------------------------------------
WEB_PORT=8080
